{
  "name": "smpl-menubar-site",
  "main": "worker.js",
  "account_id": "8ef5f0769d30e76799982b88b435da03",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/download",
      "/events/brew-copy",
      "/analytics",
      "/analytics/*"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "smpl_menubar_actions"
    }
  ],
  "routes": [
    {
      "pattern": "smpl-menubar.tnitish.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ACCESS_AUD": "e8c5010889c9508c8e94cde4619b2e0ff89a54df690e791b43efdf86682d9aab"
  }
}
